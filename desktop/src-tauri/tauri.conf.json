{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kim",
  "version": "0.1.0",
  "identifier": "me.vishalojha.kim",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Kim",
        "width": 1180,
        "height": 760,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "decorations": true,
        "transparent": false,
        "backgroundColor": "#090a0c"
      }
    ],
    "security": {
      "csp": "default-src 'self' https://app.vishalojha.me; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src https://app.vishalojha.me"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/kim-orb.svg"],
    "category": "Utility",
    "shortDescription": "Kim personal agent"
  }
}
