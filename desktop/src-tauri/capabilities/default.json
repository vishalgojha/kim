{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Kim main window may open its PropAI authentication and browser windows.",
  "windows": ["main", "propai-auth", "kim-browser-*"],
  "permissions": [
    "core:default",
    "core:webview:allow-create-webview-window",
    "core:window:allow-create",
    "core:window:allow-close"
  ]
}
