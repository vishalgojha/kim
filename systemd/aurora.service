[Unit]
Description=Kim laptop desktop relay (microphone disabled)
After=sound.target

[Service]
Type=simple
WorkingDirectory=/home/vishal/aurora
EnvironmentFile=/home/vishal/aurora/.env
Environment=KIM_REMOTE_HOST=127.0.0.1
Environment=KIM_PORT=8765
ExecStart=/home/vishal/aurora/.venv/bin/python -m aurora desktop
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
