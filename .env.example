# Copy to .env and fill in your ElevenLabs API key
ELEVENLABS_API_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxx

# Kim's own text/agent brain (OpenAI-compatible endpoint; ElevenLabs is voice-only)
KIM_LLM_API_KEY=
KIM_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
KIM_LLM_MODEL=gemini-2.5-flash

# Sarvam AI fallback for text-based tool calling (used when the brain above is
# unconfigured or fails). Get a key from https://dashboard.sarvam.ai
SARVAM_API_KEY=
SARVAM_BASE_URL=https://api.sarvam.ai
SARVAM_MODEL=sarvam-105b

# Which brain answers /v1/chat text messages (voice always uses ElevenLabs).
# "agent" (default): Sarvam/default text brain with full tool calling + approvals.
# "elevenlabs": keep the ElevenLabs conversational-agent websocket as primary.
KIM_TEXT_BRAIN=agent

# Computer-agent desktop control (used via computer_action / device_command):
#   sudo apt install -y tesseract-ocr xdotool   # X11/XWayland
# For full Wayland input injection: sudo apt install -y ydotool && sudo systemctl enable --now ydotool

# Vision for computer_action see/describe: describes the screen with a multimodal
# model instead of OCR text only. Leave all three empty to reuse the primary brain
# (Gemini default) if KIM_LLM_API_KEY/GEMINI_API_KEY is set; without any key, see
# degrades to OCR. For Sarvam v2 beta (gemma4, image input):
#   KIM_VISION_BASE_URL=https://api.sarvam.ai/v2/chat/completions
#   KIM_VISION_API_KEY=<your key>
#   KIM_VISION_MODEL=gemma4
KIM_VISION_BASE_URL=
KIM_VISION_API_KEY=
KIM_VISION_MODEL=

# Max tool-call steps per chat request (default 20). Desktop verify-loops need
# more headroom than simple chat; lower it if steps are too costly.
KIM_MAX_TOOL_STEPS=20
